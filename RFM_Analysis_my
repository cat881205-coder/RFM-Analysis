      "source": [
        "from sklearn.cluster import KMeans\n",
        "\n",
        "# 提取特徵欄位\n",
        "features = nrfm[['F', 'M', 'R']]\n",
        "\n",
        "# 初始化並執行 K-means (K=4)\n",
        "kmeans = KMeans(n_clusters=4, random_state=42, n_init='auto')\n",
        "nrfm['Cluster'] = kmeans.fit_transform(features).argmin(axis=1) # 或是直接使用 kmeans.labels_\n",
        "# 更保險的方式直接賦值 labels_\n",
        "nrfm['Cluster'] = kmeans.labels_\n",
        "\n",
        "# 顯示包含分群結果的 DataFrame 前 5 筆\n",
        "display(nrfm.head())"
